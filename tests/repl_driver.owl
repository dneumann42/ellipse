use io
use base
use math
use strings
use repl

; Runs a repl session on stdin for tests, without the app: each input goes
; to repl-submit as if typed at the prompt, and the transcript entries it
; adds are printed, values after "=> ". A line ending in ':' starts a block
; that runs to the next empty line. Usage: owl run repl_driver.owl < input

seen = 0

; A screen that opens is shown by its title and cancelled.
fun print-new:
    entries = (repl-transcript)
    while (< seen (length entries)):
        e = index entries (+ seen 0)
        when (<> e.kind "input"):
            if (= e.kind "value"):
                echo "=>" e.text
                echo e.text
        set seen (+ seen 1)
    s = (repl-screen)
    when (<> s nothing):
        echo "screen:" s.title
        repl-answer nothing
        (print-new)

fun read-input:
    text = readline ""
    when (and (<> text nothing) (ends-with text ":")):
        line = readline ""
        while (and (<> line nothing) (<> line "")):
            set text (concat text newline line)
            set line (readline "")
    text

repl-start ({} (copy = nothing) (windows = false))
(print-new)
input = (read-input)
while (and (<> input nothing) (not (repl-over))):
    repl-submit input
    (print-new)
    set input (read-input)

use io
use base
use math

; User commands (hygienic, rest and block params), dynamic commands, lambdas.
command twice body+:
    do:
        forms = body
        while (not (= (length forms) 0)):
            eval (pop-front forms)
    do:
        forms = body
        while (not (= (length forms) 0)):
            eval (pop-front forms)

dynamic-command bump form:
    eval form

fun apply-n f n x:
    i = 0
    while (< i n):
        set x (f x)
        set i (+ i 1)
    x

count = 0
i = 0
while (< i 5000):
    twice:
        set count (+ count 1)
    bump (set count (+ count 1))
    unless (= i 3):
        set count (+ count 1)
    set i (+ i 1)
add3 = lambda x:
    + x 3
echo count (apply-n add3 20000 0) (max 3 (min 9 4))

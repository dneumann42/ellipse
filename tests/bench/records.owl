use io
use base
use math

; Records, lists, field access through dots, with, index, cond and and/or.
fun make-point x y:
    {} (x = x) (y = y) (tag = "pt")

fun step p:
    cond:
        (and (> p.x 50) (< p.y 10)) = (with p (x = 0))
        (or (= p.tag "zz") (> p.y 100)) = (with p (y = 0))
        true = (with p (x = (+ p.x 1)) (y = (+ p.y 2)))

pts = ([])
i = 0
while (< i 200):
    append pts (make-point i (* i 2))
    set i (+ i 1)
total = 0
round = 0
while (< round 40):
    out = ([])
    j = 0
    while (< j (length pts)):
        p = step (index pts (+ j 0))
        set total (+ total p.x p.y)
        append out p
        set j (+ j 1)
    set pts out
    set round (+ round 1)
echo total (first pts)

use io
use base
use math
use strings

; String building and the owl-level helpers in strings.owl.
s = ""
i = 0
while (< i 1500):
    set s (concat s (to-string (- i (* 10 (floor (/ i 10))))))
    set i (+ i 1)
n = 0
i = 0
while (< i 60):
    when (starts-with (drop s i) "01"):
        set n (+ n 1)
    set n (+ n (length (take s 50)))
    when (ends-with s "9"):
        set n (+ n 1)
    set i (+ i 1)
echo n (length s) (find-char s "5")

use base
use gui
export all

; Presets layered over the library default: set-theme starts from the
; default theme and applies what a preset names. Every widget reads the live
; theme while it renders, so a preset restyles the whole gallery.

fun light-theme:
    {}:
        palette = {}:
            bg = rgb 244 245 248
            panel = rgb 255 255 255
            panel-border = rgb 208 212 222
            button = rgb 226 230 238
            button-hover = rgb 203 210 224
            button-press = rgb 178 187 206
            field = rgb 255 255 255
            selected = rgb 206 221 248
            accent = rgb 46 92 190
            text = rgb 24 27 34
            dim = rgb 116 122 138
            label = rgb 72 78 94
            on-accent = rgb 255 255 255
            shadow = rgb 20 24 40 60
        scrollbar = {}:
            width = 10
            margin = 4
            radius = 5
            min-thumb = 28
            track = rgb 226 229 238 150
            thumb = rgb 150 158 176 190
            thumb-hot = rgb 112 122 145 230

fun contrast-theme:
    {}:
        palette = {}:
            bg = rgb 0 0 0
            panel = rgb 8 8 8
            panel-border = rgb 255 255 255
            button = rgb 24 24 24
            button-hover = rgb 64 64 64
            button-press = rgb 130 130 130
            field = rgb 0 0 0
            selected = rgb 0 0 128
            accent = rgb 255 214 0
            text = rgb 255 255 255
            dim = rgb 208 208 208
            label = rgb 235 235 235
            on-accent = rgb 0 0 0
            shadow = rgb 0 0 0 0
        ; sharp edges everywhere -- except the switch pill
        radii = {}:
            button = 0
            field = 0
            check = 0
            tick = 0
            inner = 0
            item = 0
            panel = 0
            popover = 0
            popover-shadow = 0
            tab = 0
            tab-panel = 0
            card = 0
            pill = 0
            switch = 12
            switch-knob = 8
        scrollbar = {}:
            width = 12
            margin = 4
            radius = 0
            min-thumb = 32
            track = rgb 24 24 24 200
            thumb = rgb 255 214 0 230
            thumb-hot = rgb 255 255 255 255

fun warm-theme:
    {}:
        palette = {}:
            bg = rgb 28 24 20
            panel = rgb 42 36 30
            panel-border = rgb 82 68 52
            button = rgb 72 60 46
            button-hover = rgb 98 82 62
            button-press = rgb 46 38 29
            field = rgb 34 29 24
            selected = rgb 92 74 52
            accent = rgb 224 164 78
            text = rgb 240 230 214
            dim = rgb 156 140 118
            label = rgb 200 184 158
            on-accent = rgb 26 22 18
            shadow = rgb 0 0 0 80
        scrollbar = {}:
            width = 10
            margin = 4
            radius = 5
            min-thumb = 28
            track = rgb 20 17 14 140
            thumb = rgb 150 128 96 180
            thumb-hot = rgb 200 170 120 235

; The theme for the gallery's Look combobox: 0 dark (the default), 1 light,
; 2 high contrast, 3 warm sepia.
fun theme-for index:
    cond:
        (= index 1) = (light-theme)
        (= index 2) = (contrast-theme)
        (= index 3) = (warm-theme)
        true = ({})

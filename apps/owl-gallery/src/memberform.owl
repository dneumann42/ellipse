use base
use math
use strings
use gui
export all

; The gallery's modal form: "Add team member", one dialog holding most of
; the input widget set at once -- text, multiline, combos, a multiselect,
; number fields, switches and checkboxes -- with validation and a
; draft/commit round trip.
;
; It is a dialog, so it opens either over the gallery or in a window of its
; own (a child process): begin-member-form mode. The form edits draft, a
; private copy seeded on the dialog's first frame; nothing the gallery shows
; changes until Submit validates it. The accepted draft travels back as
; dialog fields (to-fields / from-fields) -- across the process boundary in
; window mode -- and is appended to members. Cancel, Escape or a click on
; the backdrop throw the draft away. Errors stay hidden until the first
; submit attempt, then track every edit live. The title and footer stay put;
; the form between them scrolls when the window is too short for it.

members = ([])

; a submit was attempted: show the errors
tried = false
agreed = false
draft = (blank)

role-names = [] "Engineer" "Designer" "Product manager" "Support" "Contractor"
team-names = [] "Platform" "Renderer" "Widgets" "Tooling"
access-names = [] "Source code" "CI pipelines" "Production" "Billing" "Analytics"

fun blank:
    {}:
        name = ""
        email = ""
        bio = ""
        role = 0
        team = -1
        access = [] 0
        hours = 40
        rate = 85
        admin = false
        remote = false
        welcome = true

; --- crossing into a dialog window: fields are text -------------------------------

fun to-number s:
    index (parse s) 0

fun join-numbers xs:
    out = ""
    i = 0
    while (< i (length xs)):
        when (> i 0):
            set out (concat out " ")
        set out (concat out (to-string (index xs (+ i 0))))
        set i (+ i 1)
    out

fun numbers-of s:
    out = ([])
    word = ""
    i = 0
    while (< i (length s)):
        c = index s (+ i 0)
        if (= c " "):
            do:
                when (<> word ""):
                    append out (to-number word)
                set word ""
            set word (concat word c)
        set i (+ i 1)
    when (<> word ""):
        append out (to-number word)
    out

fun to-fields m:
    {}:
        name = m.name
        email = m.email
        bio = m.bio
        role = m.role
        team = m.team
        access = (join-numbers m.access)
        hours = m.hours
        rate = m.rate
        admin = m.admin
        remote = m.remote
        welcome = m.welcome

fun from-fields f:
    {}:
        name = f.name
        email = f.email
        bio = f.bio
        role = (to-number f.role)
        team = (to-number f.team)
        access = (numbers-of f.access)
        hours = (to-number f.hours)
        rate = (to-number f.rate)
        admin = (= f.admin "1")
        remote = (= f.remote "1")
        welcome = (= f.welcome "1")

; --- validation -----------------------------------------------------------------

fun is-blank s:
    blank-only = true
    i = 0
    while (< i (length s)):
        c = index s (+ i 0)
        when (not (or (= c " ") (or (= c (char 9)) (or (= c (char 10)) (= c (char 13)))))):
            set blank-only false
        set i (+ i 1)
    blank-only

fun name-error:
    if (is-blank draft.name):
        "A name is required."
        ""

fun email-error:
    e = draft.email
    at = find e "@"
    bad = "That doesn't look like an email address."
    cond:
        (is-blank e) = "An email is required."
        (or (= at nothing) (= at 0)) = bad
        (= (find e "." (+ at 2)) nothing) = bad
        (<> (find e " ") nothing) = bad
        (ends-with e ".") = bad
        true = ""

fun team-error:
    if (< draft.team 0):
        "Pick a team."
        ""

fun access-error:
    if (is-empty draft.access):
        "Grant at least one area."
        ""

fun hours-error:
    if (and (= draft.role 4) (> draft.hours 30)):
        "Contractors are capped at 30 hours a week."
        ""

fun agree-error:
    if agreed:
        ""
        "Confirm before adding someone."

fun valid:
    and (= (name-error) "") (and (= (email-error) "") (and (= (team-error) "") (and (= (access-error) "") (and (= (hours-error) "") (= (agree-error) "")))))

; --- verbs -----------------------------------------------------------------------

fun submit:
    set tried true
    when (valid):
        accept (to-fields draft) "add"

fun reset-form:
    set draft (blank)
    set agreed false
    set tried false

; --- drawing ---------------------------------------------------------------------

err-color = rgb 232 96 96

fun field-error msg:
    when (and tried (> (length msg) 0)):
        text msg (theme).text.caption (color = err-color)

; A form group's overline-style title.
fun group title:
    text title (theme).text.label (color = "accent")

fun money v:
    cents = floor (+ (* v 100) 0.5)
    dollars = floor (/ cents 100)
    rest = - cents (* dollars 100)
    pad = if (< rest 10):
        "0"
        ""
    concat "$" (to-string dollars) "." pad (to-string rest)

fun form-body:
    t = (theme)
    group "IDENTITY"
    row (id = "mf.r1") (width = grow) (height = fit) (gap = 12) (align-y = "top"):
        labeled "Full name":
            set draft (with draft (name = (text-field "mf.name" draft.name "Grace Hopper")))
            field-error (name-error)
        labeled "Email":
            set draft (with draft (email = (text-field "mf.email" draft.email "grace@example.com")))
            field-error (email-error)
    row (id = "mf.r2") (width = grow) (height = fit) (gap = 12) (align-y = "top"):
        labeled "Role":
            set draft (with draft (role = (combo-box "mf.role" role-names draft.role "Pick a role")))
        labeled "Team":
            set draft (with draft (team = (combo-box "mf.team" team-names draft.team "Choose a team")))
            field-error (team-error)

    group "ACCESS & SCHEDULE"
    row (id = "mf.r3") (width = grow) (height = fit) (gap = 12) (align-y = "top"):
        labeled "Access areas":
            set draft (with draft (access = (multi-select "mf.access" access-names draft.access "No access")))
            field-error (access-error)
        labeled "Hours / week":
            set draft (with draft (hours = (int-number-field "mf.hours" draft.hours 1 1 60)))
            field-error (hours-error)
        labeled "Hourly rate":
            set draft (with draft (rate = (number-field "mf.rate" draft.rate 5 0 500)))
    row (id = "mf.r4") (width = grow) (height = fit) (gap = 28) (padding = t.metrics.pad-minor) (align-y = "center"):
        set draft (with draft (admin = (switch "mf.admin" "Administrator" draft.admin)))
        set draft (with draft (remote = (switch "mf.remote" "Remote" draft.remote)))
        (spacer)
        caption (concat "Weekly cost: " (money (* draft.rate draft.hours)))

    group "ABOUT"
    labeled "Bio":
        set draft (with draft (bio = (multiline-field "mf.bio" draft.bio "A few lines for the team page..." (rows = 3) (max-lines = 6))))
    column (id = "mf.r5") (width = grow) (height = fit) (gap = 6) (padding = t.metrics.pad-minor):
        set draft (with draft (welcome = (checkbox "mf.welcome" "Send a welcome email" draft.welcome)))
        set agreed (checkbox "mf.agree" "I've checked this person's details with them" agreed)
        field-error (agree-error)

fun member-body:
    when (dialog-opened):
        set draft (blank)
        set agreed false
        set tried false
        focus-at "mf.name" draft.name
    ; Enter submits -- except in the bio, where it breaks the line
    when (focused "mf.bio"):
        (pass-enter)
    when (dialog-enter):
        (submit)
    caption "Everything below is a draft until you press Add member."
    (form-body)

fun member-footer:
    when (text-link "mf.reset" "Reset form"):
        (reset-form)
    (spacer)
    when (and tried (not (valid))):
        text "Fix the errors above" (theme).text.caption (color = err-color)
    fs = (theme).text.control
    when (button "mf.cancel" "Cancel" (width = 110) (height = 38) (font-size = fs)):
        (cancel)
    when (button "mf.submit" "Add member" (width = 130) (height = 38) (font-size = fs)):
        (submit)

define-dialog "gallery.member" (title = "Add team member") (width = 680) (max-height = 680) (scroll = true) (header = ({} (enabled = true) (fullscreen = true))) (body = member-body) (footer = member-footer)

; Open the form -- over the gallery, or in a window of its own.
fun begin-member-form (mode = "inline"):
    open-dialog "gallery.member" (mode = mode) (on-done = member-done)

fun member-done r:
    when r.accepted:
        append members (from-fields r.fields)

#!/usr/bin/env bash
# The `CC` nimony's linker step (niflink) uses for a Windows cross-build.
# Nimony links its compile-time plugins through `CC` too, and those must stay
# host programs; their output is `<plugin>.tmp.<pid>.<n>`. Everything else
# is the Windows executable and goes to mingw (which appends `.exe`).
out=""
prev=""
for arg in "$@"; do
    if [ "$prev" = "-o" ]; then out="$arg"; fi
    prev="$arg"
done
case "$out" in
    *.tmp.*) exec "${HOST_CC:-cc}" "$@" ;;
    *) exec x86_64-w64-mingw32-gcc "$@" ;;
esac

use base
use math

; String utilities built on index/concat. Because they only use index and
; concat, take, drop, and starts-with also work on lists and records.

fun starts-with s prefix:
    if (< (length s) (length prefix)):
        false
        do:
            i = 0
            ok = true
            while (< i (length prefix)):
                if (<> (index s (+ i 0)) (index prefix (+ i 0))):
                    do:
                        set ok false
                        set i (length prefix)
                    set i (+ i 1)
            ok

fun find-char s c:
    n = length s
    i = 0
    at = nothing
    while (< i n):
        if (= (index s (+ i 0)) c):
            do:
                set at i
                set i n
            set i (+ i 1)
    at

fun take s count:
    out = ""
    i = 0
    while (< i count):
        do:
            set out (concat out (index s (+ i 0)))
            set i (+ i 1)
    out

fun drop s count:
    out = ""
    i = count
    while (< i (length s)):
        do:
            set out (concat out (index s (+ i 0)))
            set i (+ i 1)
    out

export:
    starts-with = starts-with
    find-char = find-char
    take = take
    drop = drop

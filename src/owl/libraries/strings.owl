use base
use math


fun starts-with s prefix:
    = (slice s 0 (length prefix)) prefix

fun ends-with s suffix:
    = (slice s (- (length s) (length suffix))) suffix

fun find-char s c:
    find s c

fun find-last s sub:
    at = find s sub
    last = nothing
    while (not (= at nothing)):
        set last at
        set at (find s sub (+ at 1))
    last

fun take s count:
    slice s 0 count

fun drop s count:
    slice s count

export:
    starts-with = starts-with
    ends-with = ends-with
    find-char = find-char
    find-last = find-last
    take = take
    drop = drop

use base
use math
use strings
use io
use fs
use net
use wire
use repl

; The attach server: a running program answers repls on its socket (see
; wire.owl for the protocol). Inputs run in the program's own repl session
; (serve-input in repl.owl), whose documents are the program's live modules,
; so a definition typed into an attached repl changes the running program.
;
; The server never blocks the program. host says how to hear from the
; socket: watch fd f calls f whenever fd is readable, unwatch fd stops;
; after f runs f once the program has shown the effect of an input (after
; the next frame); status is the program's trouble, or nothing; quit
; closes the program. A GUI program passes the frame loop's own fd
; watching (gui.owl), so requests are handled between frames and an idle
; program stays asleep.

fun serve-attach host:
    dir = (socket-dir)
    when (not (dir-exists dir)):
        make-dir dir
    path = socket-path (process-id)
    listener = unix-listen path
    fun on-connect:
        c = sock-accept listener
        while (<> c nothing):
            serve-client host c
            set c (sock-accept listener)
    host.watch listener on-connect
    {} (path = path) (fd = listener)

fun stop-attach server:
    sock-close server.fd
    remove-file server.path

fun serve-client host c:
    buf = ""
    fun on-data:
        data = sock-read c 0
        if (= data nothing):
            do:
                host.unwatch c
                sock-close c
            do:
                set buf (concat buf data)
                m = take-message buf
                while (<> m nothing):
                    set buf m.rest
                    answer host c (parse-request m.message)
                    set m (take-message buf)
    host.watch c on-data

fun answer host c req:
    cond:
        (= req.kind "hello") = (reply c (serve-hello))
        (= req.kind "input") = (input-answer host c (serve-input req.body))
        (= req.kind "query") = (reply c (serve-query req.body))
        (= req.kind "stop") = (do (reply c "stopping") (host.quit))
        true = (reply c (concat "unknown request " req.kind))

fun reply c text:
    sock-write c (frame-message text)

; An input's answer waits for the frame that shows what it did (host.after),
; so it can tell whether that frame's view failed (host.status).
fun input-answer host c r:
    fun send:
        reply c (concat r.prompt newline (status-note host) r.output)
    host.after send

last-status = nothing

; The view's failure, told when it starts and when it ends.
fun status-note host:
    now = (host.status)
    note = cond:
        (= now last-status) = ""
        (= now nothing) = (concat "(the view runs again)" newline)
        true = (concat "(the view fails: " now ")" newline)
    set last-status now
    note

export:
    serve-attach = serve-attach
    stop-attach = stop-attach

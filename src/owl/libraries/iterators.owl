use base
use math

; An iterator is a closure that returns the next value when called,
; and nothing once it is out of items. `for` consumes one.
command for name iter body+:
    it = eval iter
    v = (it)
    while (not (= v nothing)):
        do:
            eval (pair (eval (quote name)) v)
            forms = body
            while (not (= (length forms) 0)):
                eval (pop-front forms)
            v = (it)

fun range from (to = nothing):
    cell = []:
        if (= to nothing):
            0
            from
    stop = if (= to nothing):
        from
        to
    lambda:
        i = pop cell
        if (< i stop):
            do:
                append cell (+ i 1)
                i
            do:
                append cell i
                nothing

fun items xs:
    cell = xs
    lambda:
        if (= (length cell) 0):
            nothing
            pop-front cell

export:
    for = for
    range = range
    items = items

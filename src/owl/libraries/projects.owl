use base
use math
use strings
use iterators
use fs
use modules


fun at xs i:
    index xs (+ i 0)

fun join-path a b:
    cond:
        (= a "") = b
        (ends-with a "/") = (concat a b)
        true = (concat a "/" b)

fun parent-dir path:
    last = nothing
    at-slash = find path "/"
    while (<> at-slash nothing):
        set last at-slash
        set at-slash (find path "/" (+ at-slash 1))
    cond:
        (= last nothing) = ""
        (= last 0) = "/"
        true = (slice path 0 last)

fun base-name path:
    dir = parent-dir path
    cond:
        (= dir "") = path
        (= dir "/") = (slice path 1)
        true = (slice path (+ (length dir) 1))

fun home-dir:
    home = env-var "HOME"
    when (or (= home nothing) (= home "")):
        error "~ needs HOME to be set"
    home

fun path-parts path:
    parts = ([])
    from = 0
    done = false
    while (not done):
        at-slash = find path "/" from
        stop = if (= at-slash nothing):
            length path
            at-slash
        part = slice path from stop
        when (<> part ""):
            append parts part
        if (= at-slash nothing):
            set done true
            set from (+ at-slash 1)
    parts

fun drop-last xs:
    if (is-empty xs):
        xs
        slice xs 0 (- (length xs) 1)

fun absolute-path path:
    full = cond:
        (starts-with path "/") = path
        (or (= path "~") (starts-with path "~/")) = (concat (home-dir) (slice path 1))
        true = (concat (current-dir) "/" path)
    parts = path-parts full
    kept = ([])
    while (is-any parts):
        part = pop-front parts
        cond:
            (= part "~") = (error (concat "~ is the home directory only at the start of a path: " path))
            (= part ".") = nothing
            (= part "..") = (set kept (drop-last kept))
            true = (append kept part)
    out = ""
    while (is-any kept):
        set out (concat out "/" (pop-front kept))
    if (= out ""):
        "/"
        out

fun find-project dir:
    found = nothing
    cur = dir
    searching = true
    while searching:
        if (file-exists (join-path cur "project.owl")):
            do:
                set found cur
                set searching false
            do:
                up = parent-dir cur
                when (or (= up cur) (= up "")):
                    set searching false
                set cur up
    found

fun setting scope key fallback:
    if (has-own scope key):
        eval-in scope (at (parse key) 0)
        fallback

fun text-setting scope key fallback file:
    v = setting scope key fallback
    when (<> (type-of v) "string"):
        error (concat file ": " key " must be a string, got " (to-string v))
    v

fun read-project root:
    file = join-path root "project.owl"
    scope = (new-scope)
    forms = parse (read-file file)
    while (is-any forms):
        eval-in scope (pop-front forms)
    name = text-setting scope "name" (base-name root) file
    source = text-setting scope "source" "." file
    main = text-setting scope "main" "main" file
    kind = text-setting scope "kind" "cli" file
    src = if (= source "."):
        root
        join-path root source
    {} (root = root) (file = file) (name = name) (source = src) (main = main) (kind = kind)

fun open-project dir:
    root = find-project dir
    if (= root nothing):
        nothing
        do:
            project = read-project root
            add-module-path project.source
            project

fun project-at dir:
    root = absolute-path dir
    when (not (file-exists (join-path root "project.owl"))):
        error (concat "no project.owl in " root)
    read-project root

fun in-project project path:
    and (<> path nothing) (starts-with path (concat project.source "/"))

fun close-project project:
    gone = ([])
    names = (module-names)
    while (is-any names):
        name = pop-front names
        when (in-project project (module-path name)):
            unload-module name
            append gone name
    remove-module-path project.source
    gone

fun use-project project:
    add-module-path project.source
    project

fun projects-under dir:
    out = ([])
    when (dir-exists dir):
        entries = list-dir dir
        while (is-any entries):
            e = pop-front entries
            when (and (= e.kind "dir") (file-exists (join-path (join-path dir e.name) "project.owl"))):
                append out (join-path dir e.name)
    out

fun new-project path (kind = "cli"):
    dir = absolute-path path
    when (file-exists (join-path dir "project.owl")):
        error (concat "there is a project in " dir " already")
    when (and (<> kind "cli") (<> kind "gui")):
        error (concat "a project is cli or gui, not " kind)
    name = base-name dir
    make-dir (join-path dir "src")
    write-file (join-path dir "project.owl") (project-template name kind)
    main = join-path dir "src/main.owl"
    if (= kind "gui"):
        do:
            write-new main (gui-main-template name)
            write-new (join-path dir "src/widgets.owl") (gui-widgets-template)
        write-new main (main-template name)
    dir

fun write-new path text:
    when (not (file-exists path)):
        write-file path text

fun lines-of parts:
    out = ""
    while (is-any parts):
        set out (concat out (pop-front parts) (char 10))
    out

fun quoted s:
    concat (char 34) s (char 34)

fun project-template name kind:
    lines-of ([] "; The owl project file: plain bindings, read by owl." (concat "name = " (quoted name)) "" "; Where modules live, relative to this file: `use ui/button` is" "; src/ui/button.owl." (concat "source = " (quoted "src")) "" "; The module `owl run` starts." (concat "main = " (quoted "main")) "" "; cli, or gui for a windowed app on ellipse_ui." (concat "kind = " (quoted kind)))

fun fill-template lines name:
    text = lines-of lines
    out = ""
    i = 0
    while (< i (length text)):
        c = index text (+ i 0)
        cond:
            (= c "^") = (set out (concat out (char 34)))
            (and (= c "N") (= (slice text i (+ i 4)) "NAME")) = (do (set out (concat out name)) (set i (+ i 3)))
            true = (set out (concat out c))
        set i (+ i 1)
    out

fun main-template name:
    fill-template:
        []:
            "use io"
            "use base"
            "use math"
            "use strings"
            ""
            "; The module `owl run` starts. Modules of src/ join it with `use`."
            "echo ^NAME^"
        name

fun gui-main-template name:
    fill-template ([] "use base" "use math" "use strings" "use io" "use gui" "use widgets" "" "; The app state is plain bindings: a reload keeps their values, so it" "; survives editing this file or patching it from an attached repl." "clicks = 0" "dark = true" "" "; Called every frame. Redefine it (save the file, or type a new fun view" "; into an attached repl) and the next frame shows it." "fun view:" "    handle-events:" "        event Bumped e:" "            set clicks (+ clicks e.by)" "        column (width = grow) (height = grow) (padding = 24) (gap = 16) (bg = ^bg^):" "            heading ^NAME^ 1" "            caption ^Edit src/main.owl and save, or run owl repl, then run.^" "            Counter ^clicks^ ^Clicks^ clicks" "            set dark (switch ^dark^ ^Dark^ dark)" "" "run-app (title = ^NAME^):" "    (view)") name

fun gui-widgets-template:
    fill-template ([] "use base" "use math" "use strings" "use gui" "export all" "" "; Widgets of the app. Documents the repl saves into src/ join the uses" "; of main the same way." "" "; A count with a button that asks for more. It does not change the count" "; itself: it emits Bumped, and whoever holds the count catches it." "widget Counter id label n:" "    emits Bumped by" "    row (gap = 12) (align-y = ^center^):" "        text (concat label ^: ^ (to-string n))" "        when (button (concat id ^.more^) ^+1^):" "            emit Bumped (by = 1)") ""

fun modules-under dir (prefix = ""):
    names = ([])
    entries = list-dir dir
    while (is-any entries):
        e = pop-front entries
        cond:
            (= e.kind "dir") = (set names (concat names (modules-under (join-path dir e.name) (concat prefix e.name "/"))))
            (and (= prefix "") (= e.name "project.owl")) = nothing
            (ends-with e.name ".owl") = (append names (concat prefix (slice e.name 0 (- (length e.name) 4))))
            true = nothing
    names

fun project-modules project:
    modules-under project.source


fun projects-file:
    dir = env-var "XDG_DATA_HOME"
    when (or (= dir nothing) (= dir "")):
        set dir (join-path (home-dir) ".local/share")
    join-path dir "owl/projects.owl"

fun known-projects:
    out = ([])
    for p (items (read-known)):
        append out (with p (present = (file-exists (join-path p.root "project.owl"))))
    out

fun read-known:
    file = (projects-file)
    found = ([])
    when (file-exists file):
        try (set found (eval (at (parse (read-file file)) 0))):
            set found ([])
    found

fun write-known xs:
    file = (projects-file)
    make-dir (parent-dir file)
    write-file file (concat (to-code xs 100) (char 10))

fun without-root xs root:
    out = ([])
    for p (items xs):
        when (<> p.root root):
            append out p
    out

fun remember-project project:
    known = without-root (read-known) project.root
    write-known (concat ([] ({} (name = project.name) (root = project.root))) known)
    project

fun forget-project root:
    known = (read-known)
    when (= (length (without-root known root)) (length known)):
        error (concat "owl does not know a project at " root)
    write-known (without-root known root)

fun move-project root dir:
    moved = project-at dir
    out = ([])
    found = false
    for p (items (read-known)):
        if (= p.root root):
            do:
                set found true
                append out ({} (name = moved.name) (root = moved.root))
            when (<> p.root moved.root):
                append out p
    when (not found):
        error (concat "owl does not know a project at " root)
    write-known out
    moved

export:
    join-path = join-path
    parent-dir = parent-dir
    base-name = base-name
    find-project = find-project
    read-project = read-project
    open-project = open-project
    new-project = new-project
    project-modules = project-modules
    absolute-path = absolute-path
    project-at = project-at
    in-project = in-project
    close-project = close-project
    use-project = use-project
    projects-under = projects-under
    known-projects = known-projects
    remember-project = remember-project
    forget-project = forget-project
    move-project = move-project

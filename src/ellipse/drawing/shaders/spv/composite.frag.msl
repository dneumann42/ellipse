#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 outColor [[color(0)]];
};

struct main0_in
{
    float2 vUv [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> uColor [[texture(0)]], texture2d<float> uOcclusion [[texture(1)]], sampler uColorSmplr [[sampler(0)]], sampler uOcclusionSmplr [[sampler(1)]])
{
    main0_out out = {};
    float4 color = uColor.sample(uColorSmplr, in.vUv);
    float ao = uOcclusion.sample(uOcclusionSmplr, in.vUv).x;
    out.outColor = float4(color.xyz * ao, color.w);
    return out;
}

